# Firebase 설정
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CREDENTIALS_PATH=path/to/firebase-service-account.json

# Kakao OAuth 설정
KAKAO_REST_API_KEY=your_kakao_rest_api_key
KAKAO_CLIENT_SECRET=your_kakao_client_secret
KAKAO_REDIRECT_URI=http://localhost:8000/api/auth/kakao/callback

# 카카오맵(장소 검색) 전용 키: 지도 API를 다른 앱에서 쓸 때만 입력, 비우면 위 REST 키 사용
KAKAO_MAP_REST_API_KEY=

# App Session(서비스 인증 쿠키 서명 보호)
APP_SESSION_SECRET=your_app_session_secret

# 쿠키 보안: 로컬(http)은 false, Render(https) 배포는 true
COOKIE_SECURE=false

# 로그인 후 돌아갈 화면 주소 (백엔드가 프론트를 함께 서빙하면 "/" 그대로)
FRONTEND_URL=/

# 프론트를 다른 주소(Live Server 등)에서 띄울 때만 필요, 쉼표로 구분
CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500

# n8n 내부 API 키 (n8n HTTP 노드의 X-Internal-Key 헤더와 같은 값)
INTERNAL_API_KEY=your_long_random_internal_key

# LLM 설정 (OpenAI 호환 Chat Completions 형식)
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=your_llm_api_key
LLM_MODEL=your_model_name
